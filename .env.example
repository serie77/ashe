# copy to .env and fill in. .env is gitignored.

# robinhood chain rpc. optional: leave empty for the public one, or use your own (alchemy etc.) for more headroom.
RPC_URL=

# openjev key (the decision layer)
JEV_API_KEY=

# the token this furnace buys and burns
TOKEN_ADDRESS=
# whose burns the site shows. leave empty to show the furnace wallet's own burns.
WATCH_ADDRESS=

# furnace wallet. run `npm run wallet` to mint one into .env.
PRIVATE_KEY=

# 1 = rehearse only (real jev calls, simulated transactions). 0 = live.
DRY_RUN=1
